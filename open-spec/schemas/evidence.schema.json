{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.greenvera.earth/v0.1/evidence.schema.json",
  "title": "GreenVera Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "evidence_type",
    "issuer",
    "source",
    "scope",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "supplier_declaration",
        "certificate",
        "test_report",
        "invoice",
        "meter_record",
        "lca_study",
        "epd",
        "eac",
        "audit_report",
        "software_check",
        "other"
      ]
    },
    "issuer": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "organisation_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "issuer_type": {
          "type": "string",
          "enum": [
            "supplier",
            "manufacturer",
            "laboratory",
            "programme_operator",
            "auditor",
            "software",
            "other"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "media_type": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "page_or_location": {
          "type": "string"
        },
        "document_version": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "subject"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "product_id": {
          "type": "string"
        },
        "facility_id": {
          "type": "string"
        },
        "batch_id": {
          "type": "string"
        },
        "geography": {
          "type": "string"
        },
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "quantity": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "collection_method": {
          "type": "string"
        },
        "collected_by": {
          "type": "string"
        },
        "original_record_retained": {
          "type": "boolean"
        }
      }
    },
    "access": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "restricted",
            "confidential"
          ]
        },
        "permission_ref": {
          "type": "string"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
