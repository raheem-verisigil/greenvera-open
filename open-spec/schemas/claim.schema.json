{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.greenvera.earth/v0.1/claim.schema.json",
  "title": "GreenVera Claim",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "claim_text",
    "claim_type",
    "owner",
    "scope",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "claim_text": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "environmental",
        "carbon",
        "recycled_content",
        "energy",
        "water",
        "biodiversity",
        "social",
        "other"
      ]
    },
    "owner": {
      "type": "object",
      "required": [
        "organisation_id"
      ],
      "properties": {
        "organisation_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "subject"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "product_id": {
          "type": "string"
        },
        "facility_id": {
          "type": "string"
        },
        "geography": {
          "type": "string"
        },
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "boundary": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "under_review",
        "qualified",
        "disputed",
        "withdrawn",
        "superseded"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "methodology_ref": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
