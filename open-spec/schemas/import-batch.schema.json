{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.greenvera.earth/v0.1/import-batch.schema.json",
  "title": "GOTI Source Import Batch",
  "description": "Bounded batch of source records. Transport must also supply an Idempotency-Key header.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "source-record.schema.json"
      }
    }
  }
}
