{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.greenvera.earth/v0.1/evaluation-run.schema.json",
  "title": "GreenVera Agent Evaluation Run",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "agent_id",
    "agent_version_id",
    "suite",
    "started_at",
    "status",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "agent_version_id": {
      "type": "string"
    },
    "suite": {
      "type": "string"
    },
    "harness": {
      "type": "string"
    },
    "model_reference": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "incomplete",
        "error"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "status"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "not_run",
              "error"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "details_ref": {
            "type": "string"
          }
        }
      }
    },
    "environment_digest": {
      "type": "string"
    },
    "runner_identity": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
