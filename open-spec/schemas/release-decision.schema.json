{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.greenvera.earth/v0.1/release-decision.schema.json",
  "title": "GreenVera Agent Release Decision",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "agent_id",
    "agent_version_id",
    "evaluation_id",
    "decision",
    "decided_at",
    "decision_actor"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "agent_version_id": {
      "type": "string"
    },
    "evaluation_id": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "ALLOW_WITH_CONDITIONS",
        "REQUIRE_HUMAN_APPROVAL",
        "BLOCK",
        "REASSESS"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "policy_engine",
            "human_approver"
          ]
        },
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "policy_version": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
